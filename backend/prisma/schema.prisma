generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. ROLES (Permisos y Perfiles del Sistema)
// -------------------------------------------------------------
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // "ADMIN", "USER", "MODERATOR"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  users       User[]

  @@map("roles")
}

// -------------------------------------------------------------
// 2. USUARIOS (Compradores, Vendedores y Administradores)
// -------------------------------------------------------------
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Clave foranea Role
  roleId        String    @db.ObjectId

  // Relaciones
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  profile       Profile?
  products      Product[] @relation("SellerProducts")

  @@map("users")
}

// -------------------------------------------------------------
// 2.1 PERFIL DE USUARIO (Datos de vendedor-comprador / comerciales)
// -------------------------------------------------------------
model Profile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  username      String   @unique
  avatarUrl     String?
  bio           String?
  city          String?
  country       String   @default("EspaÃƒÂ±a")
  postalCode    String?
  ratingAverage Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacion 1 a 1 con User
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("profiles")
}

// -------------------------------------------------------------
// 3. CATEGORÃƒÂAS (JerarquÃƒÂ­a con autorreferencia)
// -------------------------------------------------------------
model Category {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String     @unique
  parentId  String?    @db.ObjectId
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // RelaciÃƒÂ³n reflexiva para subcategorÃƒÂ­as
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryHierarchy")

  // RelaciÃƒÂ³n con productos
  products  Product[]

  @@map("categories")
}

// -------------------------------------------------------------
// 4. MARCAS
// -------------------------------------------------------------
model Brand {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  images    String[]  // GalerÃƒÂ­a de imÃƒÂ¡genes / banners de la marca
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // RelaciÃƒÂ³n con productos
  products  Product[]

  @@map("brands")
}

// -------------------------------------------------------------
// 5. PRODUCTOS (Entidad Base / CatÃƒÂ¡logo Padre)
// -------------------------------------------------------------
model Product {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String           @unique
  description String
  status      String           @default("available") // "available" | "reserved" | "sold" | "hidden"
  viewsCount  Int              @default(0)
  isActive    Boolean          @default(true)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Claves forÃƒÂ¡neas
  sellerId    String           @db.ObjectId
  categoryId  String           @db.ObjectId
  brandId     String           @db.ObjectId

  // Relaciones
  seller      User             @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Restrict)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]

  @@index([status, isActive, createdAt(sort: Desc)])
  @@map("products")
}

// -------------------------------------------------------------
// 6. VARIANTES DE PRODUCTO (Tallas, Colores, Estado y Precios)
// -------------------------------------------------------------
model ProductVariant {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  sku         String?        @unique
  size        String         // "XS", "S", "M", "L", "XL", "42", etc.
  color       String?        // "Negro", "Azul denim", etc.
  condition   String         // "Nuevo con etiquetas", "Muy bueno", etc.
  price       Float
  stock       Int            @default(1) // En segunda mano suele ser 1
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Clave forÃƒÂ¡nea a Product
  productId   String         @db.ObjectId

  // Relaciones
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images      ProductImage[]

  @@index([productId, size])
  @@map("product_variants")
}

// -------------------------------------------------------------
// 7. IMÃƒÂGENES DE PRODUCTO (ColecciÃƒÂ³n Independiente)
// -------------------------------------------------------------
model ProductImage {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  url         String
  altText     String?
  isCover     Boolean        @default(false) // Indica si es la foto principal
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  // Polimorfismo / IdentificaciÃƒÂ³n de entidad (ej: "PRODUCT_VARIANT", "USER", etc.)
  entityType  String?        // Tipo de entidad asociada
  entityId    String?        @db.ObjectId // ID de la entidad asociada

  // Clave forÃƒÂ¡nea a Variante
  variantId   String         @db.ObjectId

  // Relaciones
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, sortOrder])
  @@index([entityType, entityId])
  @@map("product_images")
}

// -------------------------------------------------------------
// 8. LISTA NEGRA DE TOKENS (Logout / RevocaciÃ³n de Tokens)
// -------------------------------------------------------------
model Backlist {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String    @unique
  userId    String?   @db.ObjectId
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("backlist")
}